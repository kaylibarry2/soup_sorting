from bs4 import BeautifulSoup
import requests

response = requests.get("https://news.ycombinator.com/news")


# get titles and links
soup = BeautifulSoup(response.text, "html.parser")



all_points = soup.select(".subline")


num_log = (0,"score_43661")


# find the most popular
for i in all_points:
    text = i.getText()
    parts = text.split(" ", maxsplit = 1)
    if int(parts[0]) > num_log[0]:
        span_tag = i.find("span", class_ = "score").get("id")
        num = span_tag.split("_")
        num_log = (int(parts[0]),num[1])


result = soup.find(id = num_log[1])

print(result.getText(), num_log[0])






